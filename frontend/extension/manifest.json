{
  "manifest_version": 3,
  "name": "Deceptive UI Shield & Remediation Engine",
  "version": "1.0.0",
  "description": "Real-time AI detection and remediation of dark patterns, manipulative language, and deceptive UI traps.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deceptive UI Shield"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
